# Copy to .env.local. Configure these only on the server.
SARVAM_API_KEY=
OPENAI_API_KEY=
# Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role, never a publishable key
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL connection URI. Use the Session pooler on IPv4-only networks.
DATABASE_URL=
# At least 32 random bytes
SAHVA_SESSION_SIGNING_KEY=
# Public HTTPS origin, no trailing slash
SAHVA_BASE_URL=
# Optional compatibility entry. The browser does not use the Supabase SDK.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# Optional group meeting transport. Set SAHVA_LIVEKIT=1 to enable group creation.
SAHVA_LIVEKIT=0
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
